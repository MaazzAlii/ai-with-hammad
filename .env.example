# ---------------------------------------------------------------------------
# AI With Hamad — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# ---------------------------------------------------------------------------

# Canonical public URL (no trailing slash). Used for canonical URLs, sitemap,
# Open Graph and JSON-LD. Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" ONLY on the production deployment. Anything else = noindex
# (protects preview deployments from being indexed).
NEXT_PUBLIC_ALLOW_INDEXING=false

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_…) — or legacy anon key via NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Secret key (sb_secret_…) — or legacy SUPABASE_SERVICE_ROLE_KEY.
# Needed for inviting users and deleting storage objects. Never expose to the browser.
SUPABASE_SECRET_KEY=

# SERVER ONLY. Postgres connection string (Project Settings → Database →
# Connection string → Transaction pooler, port 6543). Used by Drizzle.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# SERVER ONLY. Random string used to hash visitor IPs for rate limiting.
# Generate with: openssl rand -hex 32
IP_HASH_SALT=

# Optional: email notifications for new inquiries (Resend).
RESEND_API_KEY=
EMAIL_FROM="AI With Hamad <notifications@your-domain.com>"
# Comma-separated recipients (more can be added in Admin → Settings).
INQUIRY_NOTIFICATION_EMAIL=

# Optional: captcha. Without these the built-in HMAC arithmetic captcha is used
# (signed with CAPTCHA_SECRET, falling back to IP_HASH_SALT).
# Set BOTH Turnstile keys to switch to Cloudflare Turnstile (free).
CAPTCHA_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Self-hosting only (Docker / Contabo VPS): build the standalone server.
# BUILD_STANDALONE=1

# Optional: database connections per server process (default 5 in production, 2 during build).
# Keep it small on Vercel + Supabase; the transaction pooler (port 6543) is recommended for DATABASE_URL.
DB_POOL_MAX=

# Site assistant (Agentic RAG + chat + voice).
# Primary AI Provider: Mistral AI (https://console.mistral.ai)
MISTRAL_API_KEY=
# Mistral Chat Model: defaults to mistral-large-latest (supported: mistral-large-latest, mistral-small-latest, codestral-latest)
MISTRAL_CHAT_MODEL=mistral-large-latest
# Mistral Embedding Model: defaults to mistral-embed
MISTRAL_EMBEDDING_MODEL=mistral-embed

# Fallback AI Provider: xAI / Grok (https://console.x.ai)
XAI_API_KEY=
# Grok Chat Model: defaults to grok-2-latest (supported: grok-2-latest, grok-beta)
XAI_CHAT_MODEL=grok-2-latest

# Provider Selection & Failover Strategy
AI_PROVIDER=mistral
AI_FALLBACK_PROVIDER=xai
AI_PROVIDER_PRIORITY=mistral,xai

# RAG Knowledge Ingestion & Vector DB
# Source URL to crawl/index (defaults to NEXT_PUBLIC_SITE_URL or http://localhost:3000)
KNOWLEDGE_SOURCE_URL=http://localhost:3000
# Vector store type: "auto" (uses pgvector if available, else local file/memory store), "pgvector", "file", or "memory"
VECTOR_DB_TYPE=auto
# Max top chunks to retrieve for prompt context
RAG_TOP_K=4
# Minimum relevance threshold (0.0 to 1.0)
RAG_RELEVANCE_THRESHOLD=0.35
# Visitor chat rate limit per 10 minutes
CHAT_RATE_LIMIT=20

